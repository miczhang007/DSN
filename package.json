{
  "name": "desktop-sticky-note",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run test:all",
    "test:all": "npm run test:main && npm run test:change:recurring",
    "test:main": "npm run test:main:web && npm run test:main:rust",
    "test:main:web": "vitest run tests/App.spec.js",
    "test:main:rust": "cargo test --manifest-path src-tauri/Cargo.toml main_scenario_tests::",
    "test:change:recurring": "npm run test:change:recurring:web && npm run test:change:recurring:rust",
    "test:change:recurring:web": "vitest run tests/recurring-task-change.spec.js",
    "test:change:recurring:rust": "cargo test --manifest-path src-tauri/Cargo.toml recurring_task_change_tests::",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
